<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Version>0.1.0</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>disable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="$(TurianDir)Turian/Engine/Core/Turian.Engine.Core.csproj"/>
        <ProjectReference Include="$(TurianDir)Turian/Packages/org.mass4.turian.vulkan/Source~/Turian.Engine.Vulkan/Turian.Engine.Vulkan.csproj"/>
        <EmbeddedResource Include="../../../Runtime/Shaders~/*.spv" LogicalName="Turian.Engine.Hzb.Shaders~.%(Filename)%(Extension)"/>
        <InternalsVisibleTo Include="Turian.Hzb.Tests"/>
    </ItemGroup>
    <ItemGroup>
        <HzbShader Include="../../../Runtime/Shaders~/*.vert;../../../Runtime/Shaders~/*.comp"/>
    </ItemGroup>
    <!-- Skipping shader compilation ships the .spv committed in the tag, so a release build needs no glslc. -->
    <Target Name="CompileHzbShaders" BeforeTargets="BeforeBuild"
            Condition="'$(SkipShaders)' != 'true'"
            Inputs="@(HzbShader)" Outputs="@(HzbShader->'%(Identity).spv');../../../Runtime/Shaders~/base-single.comp.spv">
        <Exec Command="glslc &quot;%(HzbShader.Identity)&quot; -o &quot;%(HzbShader.Identity).spv&quot;"/>
        <Exec Command="glslc -DSINGLE_SAMPLE ../../../Runtime/Shaders~/base.comp -o ../../../Runtime/Shaders~/base-single.comp.spv"/>
    </Target>
    <Target Name="PrecastRuntimeAssemblies" AfterTargets="Build" Condition="'$(TargetFramework)' != ''">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BrickDir)Brick~/Precast/lib"/>
    </Target>
    <ItemGroup>
        <Compile Include="../../../Runtime/**/*.cs" />
    </ItemGroup>
</Project>
